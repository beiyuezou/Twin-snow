# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Local runtime state, credentials and generated TLS material
.env
.env.*
.iwsdk/

# A live table is accounts, tokens, decisions and payment records. The worlds are in
# PostgreSQL now, so a database file in this directory is an accident — from the version
# that kept them in one, or from somebody's experiment — and it stays out of the repo.
*.db
*.db-wal
*.db-shm

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
